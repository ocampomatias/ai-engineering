# Copiar este archivo a .env y completar. El .env esta en .gitignore: nunca se sube.
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (PowerShell)

# --- Proveedor activo -------------------------------------------------------
# Variable de configuracion que elige el cliente: "openai" o "anthropic".
LLM_PROVIDER=openai

# --- API keys ---------------------------------------------------------------
# Alcanza con una sola para probar el proyecto. La que falte da un error
# controlado, no un crash.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Modelos (opcional) -----------------------------------------------------
# Los defaults son los modelos mas baratos de cada proveedor. Para una tarea
# que necesite mas capacidad, cambialos aca (ej. claude-opus-5).
# Para ver que modelos habilita tu key: python main.py --list-models
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Control de flujo (opcional) --------------------------------------------
# Tope de llamadas simultaneas (semaforo). Evita el 429 al disparar lotes.
MAX_CONCURRENCY=5

# --- Pre-entrega 4: Pinecone ------------------------------------------------
# https://app.pinecone.io -> API Keys. El plan gratuito (Starter) alcanza.
PINECONE_API_KEY=
# Nombre del índice serverless. Si no existe, ingestar_pinecone.py lo crea.
INDEX_NAME=tambor-docs
# Partición dentro del índice (opcional). Default: plataforma.
PINECONE_NAMESPACE=plataforma
# Nube y región del índice (opcional). El plan gratuito solo permite aws/us-east-1.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Pre-entrega 7: API de produccion ---------------------------------------
# Redis 8 (o Redis Stack): el checkpointer de LangGraph necesita JSON y Search.
# Redis Cloud gratis: https://redis.io/try-free/ -> base -> Connect -> Redis CLI.
# Local con Docker: redis://localhost:6379
REDIS_URL=redis://default:CONTRASENA@HOST:PUERTO
# Workers que procesan la cola en paralelo y tope de segundos por ejecucion.
WORKERS=5
JOB_TIMEOUT_S=300
# Minutos que duran los checkpoints de LangGraph en Redis (cada trabajo ocupa ~0,7 MB).
CHECKPOINT_TTL_MIN=1440
# Phoenix: por defecto, el local (`phoenix serve`). Para Phoenix Cloud, la URL
# de tu espacio y la API key (https://app.phoenix.arize.com).
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=tambor-api
# PHOENIX_API_KEY=
